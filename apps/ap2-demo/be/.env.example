# Copy to .env and fill in. Real per-environment values come from CI variables — only this
# example file is committed.

PORT=3202
CORS_ORIGIN=http://localhost:5202

# The bank's AP2 connector: the MCP server DTK runs for the tenant, the same URL a user adds to
# their AI assistant. This backend calls its tools with the signed-in user's own access token, so
# it holds no DTK credential of its own.
AP2_MCP_URL=https://<ap2-mcp-host>/t/<tenant-slug>/ap2/mcp

# This backend's public URL: the stand-in shop's UCP profile announces its endpoints under it.
SHOP_PUBLIC_URL=http://localhost:3202

# Comma-separated issuer DIDs whose credentials the stand-in shop accepts. Full DIDs, not domains: a DTK
# deployment hosts every tenant's issuer on one domain. Any other credential is refused, and its DID is
# never fetched.
TRUSTED_ISSUERS=did:web:<dtk-protocol-host>:api:v1:<tenant-slug>:iss:<issuer-id>:oid4vci
