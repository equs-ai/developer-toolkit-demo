VITE_AP2_DEMO_BE_URL=http://localhost:3202

# The Tenant whose AP2 connector the demo uses, and the name the connector is shown under
VITE_TENANT_SLUG=<tenant-slug>
VITE_CONNECTOR_NAME=EQUS AP2

# Connecting the connector: DTK's users realm, through the tenant's own identity provider. The client
# must issue tokens the AP2 connector accepts (audience of the AP2 MCP API).
VITE_KC_AUTHORITY=https://<dtk-keycloak-host>/realms/users
VITE_KC_CLIENT_ID=<public-oidc-client-id>

# What the "Try it yourself" guide shows. The AP2 connector and the shop's UCP profile are
# required; the profile goes into the guide's prompts. The credential issuer is optional: without it the
# guide does not link to one.
VITE_AP2_CONNECTOR_URL=https://<ap2-mcp-host>/t/<tenant-slug>/ap2/mcp
VITE_SHOP_UCP_URL=http://localhost:3202/merchant/.well-known/ucp
VITE_CREDENTIAL_ISSUER_URL=
