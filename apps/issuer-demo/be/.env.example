# Copy to .env and fill in. Real per-environment values come from CI variables — only this
# example file is committed.

PORT=3200
CORS_ORIGIN=http://localhost:5200

# DTK APIs.
CONTROL_API_URL=https://<control-api-host>/api/v1
INTEGRATION_API_URL=https://<integration-api-host>/api/v1

# Server-to-server auth against DTK: OAuth2 client_credentials using this tenant's client in the
# DTK Keycloak agents realm. These credentials are issued by the Operator Portal.
API_AUTH_TOKEN_URL=https://<dtk-keycloak-host>/realms/agents/protocol/openid-connect/token
API_AUTH_CLIENT_ID=<tenant-client-id>
API_AUTH_CLIENT_SECRET=<tenant-client-secret>

# End-user token validation. This is the tenant's OWN (external) Keycloak (BYOIdP) — the one the frontend
# logs into — and is unrelated to the agents realm above. The backend verifies the incoming Bearer
# token against this JWKS and reads `sub` and `email` from it; it issues no session of its own.
EXT_KC_JWKS_URL=https://<external-keycloak-host>/realms/<realm>/protocol/openid-connect/certs
EXT_KC_ISSUER=https://<external-keycloak-host>/realms/<realm>
EXT_KC_AUDIENCE=demo-issuer
